  "main": "index.ts",
  "scripts": {
    "setup": "expo install react react-native react-native-svg react-native-safe-area-context @react-native-async-storage/async-storage expo-constants expo-status-bar expo-keep-awake expo-screen-orientation expo-clipboard expo-font @expo-google-fonts/barlow-condensed expo-dev-client react-native-udp buffer && expo install typescript @types/react -- --save-dev",
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --profile development --platform android",
    "build:ios": "eas build --profile development --platform ios"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.4",
    "buffer": "^6.0.3",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-screen-orientation": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-udp": "^4.1.7",
    "typescript": "~6.0.3"
