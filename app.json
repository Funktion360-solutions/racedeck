{
  "expo": {
    "name": "RaceDeck",
    "slug": "racedesk",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101513",
    "ios": {
      "bundleIdentifier": "dk.racedeck.app",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "RaceDeck henter live telemetri fra Gran Turismo 7 på din PS5 via dit lokale netværk.",
        "UIStatusBarHidden": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "RaceDeck indeholder biblioteker med understøttelse af fotobiblioteket. Den aktuelle version bruger ikke dine billeder og anmoder ikke om adgang til dem."
      }
    },
    "android": {
      "package": "dk.racedeck.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101513"
      }
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "RaceDeck bruger kun mikrofonen, når du stiller løbsingeniøren et spørgsmål.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "RaceDeck bruger mikrofonen, når du stiller løbsingeniøren et spørgsmål.",
          "speechRecognitionPermission": "RaceDeck laver dit spørgsmål om til tekst, så løbsingeniøren kan svare.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fb03bec8-2701-4dce-acc0-65f5c1f3d3b7"
      },
      "racedeck": {
        "ttsEnabled": false,
        "ttsUrl": "https://racedeck.funktion360.dk/api/tts",
        "ttsToken": ""
      }
    },
    "owner": "akselslot360s-team"
  }
}
